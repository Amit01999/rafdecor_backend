MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
DB_NAME=rafdecor
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional
PUBLIC_SITE_URL=http://localhost:3000
WP_SOURCE_URL=https://rafdecor.shop
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
# Steadfast Courier — leave unset to keep "Send to Steadfast" and the webhook disabled (both fail safely with a 503)
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
# Bearer token you set in Steadfast's merchant portal for webhook delivery-status callbacks (separate from the API key/secret above)
STEADFAST_WEBHOOK_TOKEN=
# Only needed if Steadfast's API host differs from the default baked into services/steadfast.py
STEADFAST_API_BASE=
